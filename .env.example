# Teknosem Robotik — environment variables.
# Copy to .env.local for local work; set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values. .env* files are git-ignored (except this template).

# Public site address, no trailing slash. Used for canonical URLs, share images, robots.txt and sitemap.xml.
NEXT_PUBLIC_TEKNOSEM_SITE_URL=https://robotik.aoz-tech.com

# Search engine indexing. Leave "false" on test deployments; set "true" only on the production domain.
NEXT_PUBLIC_TEKNOSEM_ALLOW_INDEXING=false

# Supabase (Project Settings → API). The URL and anon key are public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS: never prefix with NEXT_PUBLIC_, never import it in client components.
# Read only through src/lib/server-env.ts (guarded by "server-only").
SUPABASE_SERVICE_ROLE_KEY=
